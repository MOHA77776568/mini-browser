{
  "name": "mini-browser",
  "version": "1.0.3",
  "description": "متصفح إنترنت مكتبي بواجهة عربية مبني على Electron",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/smoke.cjs",
    "test:cloud": "node scripts/cloud-smoke.cjs",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win portable --x64",
    "dist": "electron-builder"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "com.minibrowser.desktop",
    "productName": "Mini Browser",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
